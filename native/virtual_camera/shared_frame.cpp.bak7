#include "shared_frame.h"

#include <windows.h>

#include <atomic>
#include <cstring>
#include <iostream>
#include <mutex>

namespace
{
    constexpr wchar_t kDirectory[] = L"C:\\ProgramData\\LensLinks";
    constexpr wchar_t kFilePath[] = L"C:\\ProgramData\\LensLinks\\frame.bin";

    constexpr uint32_t kMagic = 0x52464C4Cu; // "LLFR"
    constexpr uint32_t kVersion = 1;
    constexpr size_t kHeaderSize = 64;
    constexpr size_t kMaxFrameBytes = 1920u * 1080u * 4u;
    constexpr size_t kTotalSize = kHeaderSize + kMaxFrameBytes;

    // LL_WriteFrame is documented as RGBA. The Media Foundation RGB32 stream
    // expects B,G,R,X byte order, so R and B are swapped while publishing.
    // Set to false if the producer already sends BGRA.
    constexpr bool kInputIsRgba = true;

    struct Header
    {
        uint32_t magic;
        uint32_t version;
        volatile LONG seq;       // odd while the writer is updating
        uint32_t width;
        uint32_t height;
        uint32_t frameBytes;
        uint64_t lastWriteTick;  // GetTickCount64() at publish time
    };

    static_assert(sizeof(Header) <= kHeaderSize, "header too large");

    struct Mapping
    {
        HANDLE file = INVALID_HANDLE_VALUE;
        HANDLE section = nullptr;
        uint8_t* view = nullptr;
    };

    std::mutex g_writerMutex;
    Mapping g_writer;

    std::mutex g_readerMutex;
    Mapping g_reader;
    bool g_readerLive = false;

    // ------------------------------------------------------------
    // Writer
    // ------------------------------------------------------------

    bool ensureWriter()
    {
        if (g_writer.view != nullptr)
        {
            return true;
        }

        CreateDirectoryW(kDirectory, nullptr);

        HANDLE file = CreateFileW(
            kFilePath,
            GENERIC_READ | GENERIC_WRITE,
            FILE_SHARE_READ | FILE_SHARE_WRITE,
            nullptr,
            OPEN_ALWAYS,
            FILE_ATTRIBUTE_TEMPORARY,
            nullptr);

        if (file == INVALID_HANDLE_VALUE)
        {
            std::cout << "[SharedFrame] writer: cannot open file, error "
                      << GetLastError() << std::endl;
            return false;
        }

        HANDLE section = CreateFileMappingW(
            file,
            nullptr,
            PAGE_READWRITE,
            0,
            static_cast<DWORD>(kTotalSize),
            nullptr);

        if (section == nullptr)
        {
            std::cout << "[SharedFrame] writer: CreateFileMapping failed, error "
                      << GetLastError() << std::endl;
            CloseHandle(file);
            return false;
        }

        void* view = MapViewOfFile(
            section,
            FILE_MAP_READ | FILE_MAP_WRITE,
            0,
            0,
            kTotalSize);

        if (view == nullptr)
        {
            std::cout << "[SharedFrame] writer: MapViewOfFile failed, error "
                      << GetLastError() << std::endl;
            CloseHandle(section);
            CloseHandle(file);
            return false;
        }

        Header* h = reinterpret_cast<Header*>(view);

        if (h->magic != kMagic || h->version != kVersion)
        {
            std::memset(view, 0, kHeaderSize);
            h->magic = kMagic;
            h->version = kVersion;
        }
        else if ((h->seq & 1) != 0)
        {
            // A previous writer died mid-update.
            InterlockedIncrement(&h->seq);
        }

        g_writer.file = file;
        g_writer.section = section;
        g_writer.view = static_cast<uint8_t*>(view);

        std::cout << "[SharedFrame] writer ready" << std::endl;

        return true;
    }

    // ------------------------------------------------------------
    // Reader
    // ------------------------------------------------------------

    bool ensureReader()
    {
        if (g_reader.view != nullptr)
        {
            return true;
        }

        HANDLE file = CreateFileW(
            kFilePath,
            GENERIC_READ,
            FILE_SHARE_READ | FILE_SHARE_WRITE,
            nullptr,
            OPEN_EXISTING,
            FILE_ATTRIBUTE_NORMAL,
            nullptr);

        if (file == INVALID_HANDLE_VALUE)
        {
            return false; // producer has not created it yet
        }

        LARGE_INTEGER size;

        if (!GetFileSizeEx(file, &size) ||
            static_cast<unsigned long long>(size.QuadPart) < kTotalSize)
        {
            CloseHandle(file);
            return false; // producer has not sized it yet
        }

        HANDLE section = CreateFileMappingW(
            file,
            nullptr,
            PAGE_READONLY,
            0,
            0,
            nullptr);

        if (section == nullptr)
        {
            CloseHandle(file);
            return false;
        }

        void* view = MapViewOfFile(
            section,
            FILE_MAP_READ,
            0,
            0,
            0);

        if (view == nullptr)
        {
            CloseHandle(section);
            CloseHandle(file);
            return false;
        }

        g_reader.file = file;
        g_reader.section = section;
        g_reader.view = static_cast<uint8_t*>(view);

        std::cout << "[SharedFrame] reader attached" << std::endl;

        return true;
    }
}

// ============================================================
// Publish
// ============================================================

bool SharedFrame_Publish(
    const uint8_t* rgba,
    size_t size,
    int width,
    int height)
{
    if (rgba == nullptr ||
        size == 0 ||
        size > kMaxFrameBytes ||
        width <= 0 ||
        height <= 0)
    {
        return false;
    }

    std::lock_guard<std::mutex> lock(g_writerMutex);

    if (!ensureWriter())
    {
        return false;
    }

    Header* h = reinterpret_cast<Header*>(g_writer.view);
    uint8_t* dst = g_writer.view + kHeaderSize;

    InterlockedIncrement(&h->seq); // odd: update in progress

    if (kInputIsRgba)
    {
        const size_t words = size / 4;

        for (size_t i = 0; i < words; ++i)
        {
            uint32_t p;
            std::memcpy(&p, rgba + i * 4, 4);

            p = (p & 0xFF00FF00u) |
                ((p & 0x000000FFu) << 16) |
                ((p >> 16) & 0x000000FFu);

            std::memcpy(dst + i * 4, &p, 4);
        }
    }
    else
    {
        std::memcpy(dst, rgba, size);
    }

    h->width = static_cast<uint32_t>(width);
    h->height = static_cast<uint32_t>(height);
    h->frameBytes = static_cast<uint32_t>(size);
    h->lastWriteTick = GetTickCount64();

    InterlockedIncrement(&h->seq); // even: frame complete

    return true;
}

// ============================================================
// Read
// ============================================================

bool SharedFrame_Read(
    std::vector<uint8_t>& bgra,
    int& width,
    int& height,
    unsigned maxAgeMs)
{
    std::lock_guard<std::mutex> lock(g_readerMutex);

    bool ok = false;

    if (ensureReader())
    {
        const Header* h = reinterpret_cast<const Header*>(g_reader.view);
        const uint8_t* src = g_reader.view + kHeaderSize;

        if (h->magic == kMagic && h->version == kVersion)
        {
            for (int attempt = 0; attempt < 5 && !ok; ++attempt)
            {
                const LONG s1 = *reinterpret_cast<const volatile LONG*>(&h->seq);
                std::atomic_thread_fence(std::memory_order_seq_cst);

                if ((s1 & 1) != 0)
                {
                    Sleep(1); // writer is mid-update
                    continue;
                }

                const uint32_t w = h->width;
                const uint32_t ht = h->height;
                uint32_t bytes = h->frameBytes;
                const uint64_t tick = h->lastWriteTick;

                if (bytes > kMaxFrameBytes)
                {
                    bytes = static_cast<uint32_t>(kMaxFrameBytes);
                }

                bgra.resize(bytes);

                if (bytes != 0)
                {
                    std::memcpy(bgra.data(), src, bytes);
                }

                std::atomic_thread_fence(std::memory_order_seq_cst);
                const LONG s2 = *reinterpret_cast<const volatile LONG*>(&h->seq);

                if (s1 != s2)
                {
                    continue; // frame changed while copying, retry
                }

                if (bytes == 0 ||
                    w == 0 ||
                    ht == 0 ||
                    static_cast<uint64_t>(w) * ht * 4u != bytes)
                {
                    break; // nothing valid published yet
                }

                if (GetTickCount64() - tick > maxAgeMs)
                {
                    break; // producer stopped writing
                }

                width = static_cast<int>(w);
                height = static_cast<int>(ht);
                ok = true;
            }
        }
    }

    if (ok != g_readerLive)
    {
        g_readerLive = ok;

        std::cout << (ok
            ? "[SharedFrame] producer frames found"
            : "[SharedFrame] producer frames lost or not started")
                  << std::endl;
    }

    return ok;
}

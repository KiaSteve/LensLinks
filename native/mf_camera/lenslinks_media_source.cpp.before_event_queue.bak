#include "lenslinks_media_source.h"

#include "lenslinks_media_stream.h"

#include <iostream>

LensLinksMediaSource::LensLinksMediaSource()
{
    std::cout
        << "[LensLinksMediaSource] created"
        << std::endl;

    HRESULT hr;

    // ------------------------------------------------------------
    // Source attributes
    // ------------------------------------------------------------
    hr = MFCreateAttributes(&sourceAttributes_, 8);

    if (FAILED(hr))
    {
        std::cerr
            << "[LensLinksMediaSource] MFCreateAttributes failed: 0x"
            << std::hex
            << hr
            << std::dec
            << std::endl;

        return;
    }

    // ------------------------------------------------------------
    // Create the media stream
    // ------------------------------------------------------------
    stream_ = new LensLinksMediaStream(this);

    if (stream_ == nullptr)
    {
        std::cerr
            << "[LensLinksMediaSource] stream allocation failed"
            << std::endl;

        return;
    }

    // ------------------------------------------------------------
    // Create the video media type
    // ------------------------------------------------------------
    IMFMediaType* mediaType = nullptr;

    hr = MFCreateMediaType(&mediaType);

    if (FAILED(hr))
    {
        std::cerr
            << "[LensLinksMediaSource] MFCreateMediaType failed: 0x"
            << std::hex
            << hr
            << std::dec
            << std::endl;

        return;
    }

    hr = mediaType->SetGUID(
        MF_MT_MAJOR_TYPE,
        MFMediaType_Video);

    if (FAILED(hr))
    {
        std::cerr
            << "[LensLinksMediaSource] Set major type failed: 0x"
            << std::hex
            << hr
            << std::dec
            << std::endl;

        mediaType->Release();
        return;
    }

    hr = mediaType->SetGUID(
        MF_MT_SUBTYPE,
        MFVideoFormat_RGB32);

    if (FAILED(hr))
    {
        std::cerr
            << "[LensLinksMediaSource] Set subtype failed: 0x"
            << std::hex
            << hr
            << std::dec
            << std::endl;

        mediaType->Release();
        return;
    }

    hr = MFSetAttributeSize(
        mediaType,
        MF_MT_FRAME_SIZE,
        1280,
        720);

    if (FAILED(hr))
    {
        std::cerr
            << "[LensLinksMediaSource] Set frame size failed: 0x"
            << std::hex
            << hr
            << std::dec
            << std::endl;

        mediaType->Release();
        return;
    }

    hr = MFSetAttributeRatio(
        mediaType,
        MF_MT_FRAME_RATE,
        30,
        1);

    if (FAILED(hr))
    {
        std::cerr
            << "[LensLinksMediaSource] Set frame rate failed: 0x"
            << std::hex
            << hr
            << std::dec
            << std::endl;

        mediaType->Release();
        return;
    }

    hr = MFSetAttributeRatio(
        mediaType,
        MF_MT_PIXEL_ASPECT_RATIO,
        1,
        1);

    if (FAILED(hr))
    {
        std::cerr
            << "[LensLinksMediaSource] Set pixel aspect ratio failed: 0x"
            << std::hex
            << hr
            << std::dec
            << std::endl;

        mediaType->Release();
        return;
    }

    hr = mediaType->SetUINT32(
        MF_MT_INTERLACE_MODE,
        MFVideoInterlace_Progressive);

    if (FAILED(hr))
    {
        std::cerr
            << "[LensLinksMediaSource] Set interlace mode failed: 0x"
            << std::hex
            << hr
            << std::dec
            << std::endl;

        mediaType->Release();
        return;
    }

    // ------------------------------------------------------------
    // Create stream descriptor
    // ------------------------------------------------------------
    IMFStreamDescriptor* streamDescriptor = nullptr;

    hr = MFCreateStreamDescriptor(
        0,
        1,
        &mediaType,
        &streamDescriptor);

    mediaType->Release();

    if (FAILED(hr))
    {
        std::cerr
            << "[LensLinksMediaSource] MFCreateStreamDescriptor failed: 0x"
            << std::hex
            << hr
            << std::dec
            << std::endl;

        return;
    }

    // Give the stream its descriptor.
    hr = stream_->setStreamDescriptor(streamDescriptor);

    if (FAILED(hr))
    {
        std::cerr
            << "[LensLinksMediaSource] setStreamDescriptor failed: 0x"
            << std::hex
            << hr
            << std::dec
            << std::endl;

        streamDescriptor->Release();
        return;
    }

    // ------------------------------------------------------------
    // Create presentation descriptor
    // ------------------------------------------------------------
    hr = MFCreatePresentationDescriptor(
        1,
        &streamDescriptor,
        &presentationDescriptor_);

    if (FAILED(hr))
    {
        std::cerr
            << "[LensLinksMediaSource] MFCreatePresentationDescriptor failed: 0x"
            << std::hex
            << hr
            << std::dec
            << std::endl;

        streamDescriptor->Release();
        return;
    }

    // MFCreatePresentationDescriptor creates the descriptor with
    // no streams selected, so select our only video stream.
    hr = presentationDescriptor_->SelectStream(0);

    if (FAILED(hr))
    {
        std::cerr
            << "[LensLinksMediaSource] SelectStream failed: 0x"
            << std::hex
            << hr
            << std::dec
            << std::endl;

        streamDescriptor->Release();
        return;
    }

    streamDescriptor->Release();

    std::cout
        << "[LensLinksMediaSource] video stream initialized "
        << "1280x720 @ 30fps RGB32"
        << std::endl;
}

LensLinksMediaSource::~LensLinksMediaSource()
{
    if (presentationDescriptor_)
    {
        presentationDescriptor_->Release();
        presentationDescriptor_ = nullptr;
    }

    if (stream_)
    {
        stream_->Release();
        stream_ = nullptr;
    }

    if (sourceAttributes_)
    {
        sourceAttributes_->Release();
        sourceAttributes_ = nullptr;
    }

    std::cout
        << "[LensLinksMediaSource] destroyed"
        << std::endl;
}

HRESULT STDMETHODCALLTYPE LensLinksMediaSource::QueryInterface(
    REFIID riid,
    void** ppvObject)
{
    if (ppvObject == nullptr)
        return E_POINTER;

    *ppvObject = nullptr;

    std::cout
        << "[LensLinksMediaSource] QueryInterface IID="
        << std::hex
        << riid.Data1
        << "-"
        << riid.Data2
        << "-"
        << riid.Data3
        << std::dec
        << std::endl;

    if (riid == IID_IUnknown ||
        riid == IID_IMFMediaEventGenerator ||
        riid == IID_IMFMediaSource ||
        riid == IID_IMFMediaSourceEx)
    {
        *ppvObject =
            static_cast<IMFMediaSourceEx*>(this);

        AddRef();

        std::cout
            << "[LensLinksMediaSource] QueryInterface SUCCESS"
            << std::endl;

        return S_OK;
    }

    std::cout
        << "[LensLinksMediaSource] QueryInterface E_NOINTERFACE"
        << std::endl;

    return E_NOINTERFACE;
}

ULONG STDMETHODCALLTYPE LensLinksMediaSource::AddRef()
{
    return static_cast<ULONG>(
        InterlockedIncrement(&refCount_));
}

ULONG STDMETHODCALLTYPE LensLinksMediaSource::Release()
{
    ULONG count = static_cast<ULONG>(
        InterlockedDecrement(&refCount_));

    if (count == 0)
        delete this;

    return count;
}

HRESULT STDMETHODCALLTYPE LensLinksMediaSource::GetEvent(
    DWORD dwFlags,
    IMFMediaEvent** ppEvent)
{
    if (ppEvent == nullptr)
        return E_POINTER;

    *ppEvent = nullptr;

    return MF_E_NO_EVENTS_AVAILABLE;
}

HRESULT STDMETHODCALLTYPE LensLinksMediaSource::BeginGetEvent(
    IMFAsyncCallback*,
    IUnknown*)
{
    return MF_E_SHUTDOWN;
}

HRESULT STDMETHODCALLTYPE LensLinksMediaSource::EndGetEvent(
    IMFAsyncResult*,
    IMFMediaEvent** ppEvent)
{
    if (ppEvent == nullptr)
        return E_POINTER;

    *ppEvent = nullptr;

    return MF_E_SHUTDOWN;
}

HRESULT STDMETHODCALLTYPE LensLinksMediaSource::QueueEvent(
    MediaEventType,
    REFGUID,
    HRESULT,
    const PROPVARIANT*)
{
    return shutdown_
        ? MF_E_SHUTDOWN
        : S_OK;
}

HRESULT STDMETHODCALLTYPE LensLinksMediaSource::GetCharacteristics(
    DWORD* pdwCharacteristics)
{
    if (pdwCharacteristics == nullptr)
        return E_POINTER;

    *pdwCharacteristics = MFMEDIASOURCE_IS_LIVE;

    return S_OK;
}

HRESULT STDMETHODCALLTYPE LensLinksMediaSource::CreatePresentationDescriptor(
    IMFPresentationDescriptor** ppPresentationDescriptor)
{
    if (ppPresentationDescriptor == nullptr)
        return E_POINTER;

    *ppPresentationDescriptor = nullptr;

    if (shutdown_)
        return MF_E_SHUTDOWN;

    if (presentationDescriptor_ == nullptr)
        return MF_E_NOT_INITIALIZED;

    *ppPresentationDescriptor = presentationDescriptor_;
    presentationDescriptor_->AddRef();

    std::cout
        << "[LensLinksMediaSource] presentation descriptor returned"
        << std::endl;

    return S_OK;
}

HRESULT STDMETHODCALLTYPE LensLinksMediaSource::Start(
    IMFPresentationDescriptor* pPresentationDescriptor,
    const GUID*,
    const PROPVARIANT*)
{
    if (shutdown_)
        return MF_E_SHUTDOWN;

    if (pPresentationDescriptor == nullptr)
        return E_POINTER;

    std::cout
        << "[LensLinksMediaSource] Start"
        << std::endl;

    return S_OK;
}

HRESULT STDMETHODCALLTYPE LensLinksMediaSource::Stop()
{
    if (shutdown_)
        return MF_E_SHUTDOWN;

    std::cout
        << "[LensLinksMediaSource] Stop"
        << std::endl;

    return S_OK;
}

HRESULT STDMETHODCALLTYPE LensLinksMediaSource::Pause()
{
    if (shutdown_)
        return MF_E_SHUTDOWN;

    return MF_E_INVALID_STATE_TRANSITION;
}

HRESULT STDMETHODCALLTYPE LensLinksMediaSource::Shutdown()
{
    if (shutdown_)
        return S_OK;

    shutdown_ = true;

    if (presentationDescriptor_)
    {
        presentationDescriptor_->Release();
        presentationDescriptor_ = nullptr;
    }

    if (stream_)
    {
        stream_->Release();
        stream_ = nullptr;
    }

    if (sourceAttributes_)
    {
        sourceAttributes_->Release();
        sourceAttributes_ = nullptr;
    }

    std::cout
        << "[LensLinksMediaSource] Shutdown"
        << std::endl;

    return S_OK;
}

// IMFMediaSourceEx

HRESULT STDMETHODCALLTYPE LensLinksMediaSource::GetSourceAttributes(
    IMFAttributes** ppAttributes)
{
    if (ppAttributes == nullptr)
        return E_POINTER;

    *ppAttributes = nullptr;

    if (shutdown_)
        return MF_E_SHUTDOWN;

    if (sourceAttributes_ == nullptr)
        return MF_E_NOT_INITIALIZED;

    *ppAttributes = sourceAttributes_;
    sourceAttributes_->AddRef();

    std::cout
        << "[LensLinksMediaSource] GetSourceAttributes"
        << std::endl;

    return S_OK;
}

HRESULT STDMETHODCALLTYPE LensLinksMediaSource::GetStreamAttributes(
    DWORD,
    IMFAttributes** ppAttributes)
{
    if (ppAttributes == nullptr)
        return E_POINTER;

    *ppAttributes = nullptr;

    if (shutdown_)
        return MF_E_SHUTDOWN;

    return E_NOTIMPL;
}

HRESULT STDMETHODCALLTYPE LensLinksMediaSource::SetD3DManager(
    IUnknown*)
{
    if (shutdown_)
        return MF_E_SHUTDOWN;

    return E_NOTIMPL;
}

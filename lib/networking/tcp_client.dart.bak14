import 'dart:async';
import 'dart:io';
import 'dart:typed_data';

import 'package:flutter/foundation.dart';
import 'package:image/image.dart' as img;

import '../ffi/virtual_camera_bridge.dart';

class TcpClient {
  Socket? _socket;

  final StreamController<Uint8List> _frameController =
      StreamController<Uint8List>.broadcast();

  Stream<Uint8List> get frames => _frameController.stream;

  final List<int> _buffer = [];

  VoidCallback? onDisconnected;

  bool _disconnecting = false;
  int _bytesIn = 0;
  int _framesIn = 0;
  int _framesDecoded = 0;
  int _decodeUs = 0;
  int _totalUs = 0;
  int _statStartMs = DateTime.now().millisecondsSinceEpoch;

  bool get connected => _socket != null;

  Future<void> connect(String ip) async {
    if (connected) {
      await disconnect();
    }

    try {
      _buffer.clear();

      _socket = await Socket.connect(
        ip,
        5001,
        timeout: const Duration(seconds: 5),
      );

      // Initialize the native virtual camera
      await VirtualCameraBridge.instance.load();

      debugPrint("Connected to $ip:5001");

      _socket!.listen(
        _onData,
        onDone: () {
          debugPrint("SERVER CLOSED THE CONNECTION");
          _handleDisconnect();
        },
        onError: (e, st) {
          debugPrint("TCP ERROR: $e");
          debugPrint("$st");
          _handleDisconnect();
        },
        cancelOnError: true,
      );
    } catch (e) {
      debugPrint("Failed to connect: $e");
      _handleDisconnect();
    }
  }

  void _handleDisconnect() {
    if (_disconnecting) return;

    _disconnecting = true;

    debugPrint("Disconnected from server");

    try {
      _socket?.destroy();
    } catch (_) {}

    _socket = null;
    _buffer.clear();

    onDisconnected?.call();

    _disconnecting = false;
  }

  void _onData(Uint8List data) {
    _bytesIn += data.length;
    final nowMs = DateTime.now().millisecondsSinceEpoch;
    if (nowMs - _statStartMs >= 5000) {
      debugPrint("NET: ${(_bytesIn * 8 / 1000000 / ((nowMs - _statStartMs) / 1000)).toStringAsFixed(1)} Mbit/s, ${_framesIn / ((nowMs - _statStartMs) / 1000)} frames/s, avg decode ${_framesDecoded == 0 ? 0 : _decodeUs ~/ _framesDecoded} us");
      debugPrint("PROC: avg total ${_framesDecoded == 0 ? 0 : _totalUs ~/ _framesDecoded} us per frame"); _totalUs = 0; _bytesIn = 0; _framesIn = 0; _decodeUs = 0; _framesDecoded = 0; _statStartMs = nowMs;
    }
    _buffer.addAll(data);

    while (true) {
      if (_buffer.length < 4) return;

      final header = ByteData.sublistView(
        Uint8List.fromList(_buffer.sublist(0, 4)),
      );

      final frameLength = header.getUint32(0, Endian.big);

      if (_buffer.length < frameLength + 4) return;

      final jpeg = Uint8List.fromList(_buffer.sublist(4, 4 + frameLength));
      _framesIn++;

      // Flutter preview
      _frameController.add(jpeg);

      // Send frame to native virtual camera
      try {
        final sw = Stopwatch()..start();
        final decoded = img.decodeJpg(jpeg);
        _decodeUs += sw.elapsedMicroseconds;
        _framesDecoded++;

        if (decoded != null) {
          // The native side needs exactly 1280x720 RGBA (4 bytes per pixel).
          // decodeJpg returns 3-channel RGB, so convert to 4 channels,
          // and resize if the sender uses another resolution.
          var frame = decoded;
          if (frame.width != 1280 || frame.height != 720) {
            frame = img.copyResize(frame, width: 1280, height: 720);
          }
          final rgba = frame.convert(numChannels: 4, alpha: 255).toUint8List();

          VirtualCameraBridge.instance.sendFrame(
            rgba,
            frame.width,
            frame.height,
          );
          _totalUs += sw.elapsedMicroseconds;
        }
      } catch (e) {
        debugPrint("Virtual Camera Error: $e");
      }

      _buffer.removeRange(0, frameLength + 4);
    }
  }

  Future<void> disconnect() async {
    if (_disconnecting) return;

    _disconnecting = true;

    try {
      await _socket?.flush();
    } catch (_) {}

    try {
      await _socket?.close();
    } catch (_) {}

    try {
      _socket?.destroy();
    } catch (_) {}

    _socket = null;
    _buffer.clear();

    _disconnecting = false;
  }

  Future<void> dispose() async {
    await disconnect();

    // Shut down the native virtual camera
    VirtualCameraBridge.instance.dispose();

    await _frameController.close();
  }
}
